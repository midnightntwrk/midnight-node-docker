# If your on windows use wsl / git bash / cygwin / msys2 with direnv

# Public networks: preview, preprod, mainnet
export CFG_PRESET=preview

source ./.envrc.${CFG_PRESET}

# This repository only accepts signed commits:

# point out to users at commit time that commits need to be signed,
# not once they've done many commits and are trying to push a PR:
git config --local commit.gpgSign true
git config --local tag.gpgSign true

# docker on mac expects linux/arm64/v8 but currently we don't publish that build
if [[ "$(uname -s)" == "Darwin" ]] && [[ "$(uname -m)" == "arm64" ]]; then
  export DOCKER_DEFAULT_PLATFORM=linux/arm64
fi

export POSTGRES_HOST="postgres" # TODO: replace with IP or host to postgres connection if not connecting to the docker one.
export POSTGRES_PORT="5432"
# Port that compose-partner-chains.yml publishes on the host's loopback
# interface, for psql and check-chain.sh. Change it if 5432 is taken.
export POSTGRES_HOST_PORT="${POSTGRES_HOST_PORT:-5432}"
export POSTGRES_USER="postgres"

# A random password is used for your safety. Docker (but not podman) exposes
# ports to the internet by default. This needs to be unguessable.
if [ ! -f postgres.password ]; then
    uuidgen | tr -d '-' | head -c 16 > postgres.password
fi
export POSTGRES_PASSWORD="$(cat ./postgres.password)"

export POSTGRES_DB="cexplorer"

# Since node 2.1.101 the node connects to db-sync's Postgres only over TLS and
# refuses a server that does not offer it. Create a local CA and a server
# certificate for the postgres service once. The node checks the server
# against ca.crt (SSL_ROOT_CERT in compose.yml).
if [ ! -f postgres-tls/server.crt ]; then
  mkdir -p postgres-tls
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj "/CN=midnight-node-docker local CA" \
    -keyout postgres-tls/ca.key -out postgres-tls/ca.crt 2>/dev/null
  openssl req -newkey rsa:2048 -nodes -subj "/CN=${POSTGRES_HOST}" \
    -keyout postgres-tls/server.key -out postgres-tls/server.csr 2>/dev/null
  printf 'subjectAltName=DNS:%s,DNS:localhost,IP:127.0.0.1\n' "${POSTGRES_HOST}" > postgres-tls/server.ext
  openssl x509 -req -in postgres-tls/server.csr \
    -CA postgres-tls/ca.crt -CAkey postgres-tls/ca.key -CAcreateserial -days 3650 \
    -extfile postgres-tls/server.ext -out postgres-tls/server.crt 2>/dev/null
  rm -f postgres-tls/server.csr postgres-tls/server.ext postgres-tls/ca.srl
  chmod 644 postgres-tls/ca.crt postgres-tls/server.crt
  chmod 600 postgres-tls/ca.key postgres-tls/server.key
fi

# We bring together the above variables into a database connection string:
export DB_SYNC_POSTGRES_CONNECTION_STRING="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB"


# To start with debug logs, add "-l debug" to APPEND_ARGS
# To expose safe rpc method to the host port 9944, add "--unsafe-rpc-external" to APPEND_ARGS or  --validator
export APPEND_ARGS="--allow-private-ip --pool-limit 10 --trie-cache-size 0 --prometheus-external --rpc-external --rpc-cors all"


# Validator Values:
if [ ! -f midnight-node.privatekey ]; then
  # generate node key like this:
  DOCKER_DEFAULT_PLATFORM=linux/amd64 docker run --rm -it docker.io/parity/subkey:latest generate-node-key  | sed -n '2p' > midnight-node.privatekey
  # Use the second line of output for NODE_KEY (that's what sed -n '2p' does)
fi
export NODE_KEY="$(cat ./midnight-node.privatekey)"

#
# Cardano chain config:
#
# Versions from https://docs.midnight.network/nodes/cardano-db-sync
export CARDANO_NETWORK="${CARDANO_NETWORK:-preview}"
export CARDANO_IMAGE="ghcr.io/intersectmbo/cardano-node:11.0.1"
export CARDANO_DB_SYNC_IMAGE="ghcr.io/intersectmbo/cardano-db-sync:13.7.1.0"
export CARDANO_DATA_DIR=./cardano-data
export CARDANO_CONFIG_DIR=./cardano-config/${CARDANO_NETWORK}
